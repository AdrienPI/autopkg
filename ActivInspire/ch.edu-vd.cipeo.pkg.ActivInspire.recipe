<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Package the latest version of ActivInspire.</string>
    <key>Identifier</key>
    <string>ch.edu-vd.cipeo.pkg.ActivInspire</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>ActivInspire</string>
    </dict>
    <key>MinimumVersion</key>
    <string>0.6.1</string>
    <key>ParentRecipe</key>
    <string>ch.edu-vd.cipeo.download.ActivInspire</string>
    <key>Process</key>
    <array>

        <dict>
            <key>Processor</key>
            <string>com.github.adrienpi.SharedProcessors/GetUserHome</string>
        </dict>

        <dict>
            <key>Processor</key>
            <string>FlatPkgUnpacker</string>
            <key>Arguments</key>
            <dict>
                <key>flat_pkg_path</key>
                <string>%RECIPE_CACHE_DIR%/downloads/ActivInspire.dmg/ActivInspire*.pkg</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/unpack</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>Copier</string>
            <key>Arguments</key>
            <dict>
                <key>source_path</key>
                <string>%RECIPE_CACHE_DIR%/downloads/ActivInspire.dmg/ActivInspire*.pkg</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/downloads/ActivInspire.pkg</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>FlatPkgUnpacker</string>
            <key>Arguments</key>
            <dict>
                <key>flat_pkg_path</key>
                <string>%RECIPE_CACHE_DIR%/downloads/ActivInspire.pkg</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/unpack</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>PkgPayloadUnpacker</string>
            <key>Arguments</key>
            <dict>
                <key>pkg_payload_path</key>
                <string>%RECIPE_CACHE_DIR%/unpack/InspireInstaller.pkg/Payload</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/payload</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>PlistReader</string>
            <key>Arguments</key>
            <dict>
                <key>info_path</key>
                <string>%RECIPE_CACHE_DIR%/payload/Applications/Promethean/Activsoftware Inspire/Inspire.app/Contents/Info.plist</string>
                <key>plist_keys</key>
                <dict>
                    <key>CFBundleIdentifier</key>
                    <string>bundle_identifier</string>
                    <key>CFBundleShortVersionString</key>
                    <string>version</string>
                    <key>CFBundleName</key>
                    <string>name</string>
                </dict>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>com.github.adrienpi.SharedProcessors/VersionCheck</string>
            <key>Arguments</key>
            <dict>
                <key>version</key>
                <string>%version%</string>
                <key>pkg_path</key>
                <string>%RECIPE_CACHE_DIR%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>StopProcessingIf</string>
            <key>Arguments</key>
            <dict>
                <key>predicate</key>
                <string>version_exists == True</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>Copier</string>
            <key>Arguments</key>
            <dict>
                <key>source_path</key>
                <string>%RECIPE_CACHE_DIR%/downloads/%name%.pkg</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/%name%-%version%.pkg</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>Copier</string>
            <key>Arguments</key>
            <dict>
                <key>source_path</key>
                <string>%RECIPE_CACHE_DIR%/%name%-%version%.pkg</string>
                <key>destination_path</key>
                <string>/Users/%current_user%/Desktop/packagesupload/%name%-%version%.pkg</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>com.github.adrienpi.SharedProcessors/CSVWriter_titleeditor</string>
            <key>Arguments</key>
            <dict>
                <key>app_name</key>
                <string>%name%-%version%.pkg</string>
                <key>app_version</key>
                <string>%version%</string>
                <key>category</key>
                <string>Tableau interactif</string>
                <key>softwaretitle_name</key>
                <string>%name%</string>
                <key>app_minimum_version</key>
                <string>13.0</string>
                <key>bundle_identifier</key>
                <string>%bundle_identifier%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>Copier</string>
            <key>Arguments</key>
            <dict>
                <key>source_path</key>
                <string>%RECIPE_CACHE_DIR%/%name%-%version%.pkg</string>
                <key>destination_path</key>
                <string>/Users/%current_user%/Desktop/packagesupload/%name%-latest.pkg</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>com.github.adrienpi.SharedProcessors/CSVWriter_titleeditor</string>
            <key>Arguments</key>
            <dict>
                <key>app_name</key>
                <string>%name%-latest.pkg</string>
                <key>app_version</key>
                <string>%version%</string>
                <key>category</key>
                <string>Tableau interactif</string>
                <key>softwaretitle_name</key>
                <string>%name%</string>
                <key>app_minimum_version</key>
                <string>13.0</string>
                <key>bundle_identifier</key>
                <string>%bundle_identifier%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>com.github.adrienpi.SharedProcessors/TeamsNotification</string>
        </dict>

        <dict>
            <key>Processor</key>
            <string>PathDeleter</string>
            <key>Arguments</key>
            <dict>
                <key>path_list</key>
                <array>
                    <string>%RECIPE_CACHE_DIR%/unpack</string>
                    <string>%RECIPE_CACHE_DIR%/payload</string>
                </array>
            </dict>
        </dict>

    </array>
</dict>
</plist>